{
  "name": "@basekick-labs/memtrace-sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for Memtrace — LLM-agnostic memory layer for AI agents",
  "license": "MIT",
  "author": "Basekick Labs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Basekick-Labs/memtrace",
    "directory": "sdks/typescript"
  },
  "homepage": "https://basekick.net/memtrace",
  "bugs": {
    "url": "https://github.com/Basekick-Labs/memtrace/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "memtrace",
    "ai",
    "agents",
    "memory",
    "llm"
  ]
}
